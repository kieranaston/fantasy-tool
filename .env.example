# Copy to .env in the repo root (gitignored).

# Required for Gemini one-liner blurbs on the player news page
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Cap players summarized with Gemini per run (default: 24); rest next day
# MAX_NARRATIVE_PLAYERS=24
