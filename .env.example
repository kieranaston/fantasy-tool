# Copy to .env in the repo root (gitignored).

# Required for Bluesky LLM fallback and grounded summaries
GEMINI_API_KEY=

# Optional model override (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Cap Bluesky posts sent to Gemini per run (default: 16)
# MAX_BLUESKY_LLM_POSTS=16
